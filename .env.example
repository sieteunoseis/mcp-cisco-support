# Cisco API OAuth2 Configuration (Standard Support APIs)
CISCO_CLIENT_ID=your_client_id_here
CISCO_CLIENT_SECRET=your_client_secret_here

# Server Configuration
PORT=3000
NODE_ENV=development

# API Support Configuration
# Comma-separated list of Cisco Support APIs your API key can access:
#   bug, psirt, eox, product, serial, software, case, rma   (or 'all')
# Tools are enabled per API (see README "Tools"):
#   bug      -> bug_get, bug_search, assess_upgrade
#   psirt    -> psirt_get, psirt_search
#   eox      -> eox_get            serial/product/eox -> device_lookup
#   product  -> product_get        software -> software_get
#   case     -> case_get, case_search          rma -> rma_get
# SUPPORT_API=bug,psirt,software,eox
# SUPPORT_API=all
SUPPORT_API=bug

# Output format
# Responses use GCF (compact text) by default; set to 'true' to return JSON instead
# DISABLE_TOON_FORMAT=false

# HTTP Authentication Configuration (for --http mode only)

# Bearer Token Authentication
# Custom Bearer token for HTTP authentication (optional - generates random token if not set)
# Generate a token with: npx mcp-cisco-support --generate-token
# MCP_BEARER_TOKEN=your_custom_token_here

# SECURITY WARNING: Setting this to 'true' disables HTTP authentication entirely
# Only use in development/testing environments behind secure networks
# DANGEROUSLY_OMIT_AUTH=true