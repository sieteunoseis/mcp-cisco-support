{
  "name": "mcp-cisco-support",
  "version": "3.0.0",
  "description": "MCP server for the Cisco Support APIs: bugs, security advisories, end-of-life, coverage, software, cases and RMAs",
  "main": "dist/index.js",
  "bin": {
    "mcp-cisco-support": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    ".env.example",
    "Dockerfile",
    "docker-compose.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:http": "tsx watch src/index.ts -- --http",
    "stdio": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "RUN_INTEGRATION=1 jest tests/integration.test.ts",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build",
    "actions:list": "gh run list --limit 10",
    "actions:watch": "gh run watch",
    "actions:logs": "gh run view --log",
    "actions:status": "gh run list --limit 1",
    "token:generate": "npm start -- --generate-token",
    "token:help": "npm start -- --token-help",
    "inspector": "npx -y @modelcontextprotocol/inspector"
  },
  "keywords": [
    "mcp",
    "cisco",
    "support",
    "bug",
    "api",
    "server-sent-events",
    "tools"
  ],
  "author": "sieteunoseis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sieteunoseis/mcp-cisco-support.git"
  },
  "bugs": {
    "url": "https://github.com/sieteunoseis/mcp-cisco-support/issues"
  },
  "homepage": "https://github.com/sieteunoseis/mcp-cisco-support#readme",
  "dependencies": {
    "@blackwell-systems/gcf": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.24",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.6.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
