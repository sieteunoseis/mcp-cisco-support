<?xml version="1.0" encoding="UTF-8"?>
<application xmlns="http://wadl.dev.java.net/2009/02">
  <doc xml:lang="en" title="Cisco End of Life (EOX) v5.0"/>
  <resources base="https://api.cisco.com">
    <resource path="supporttools/eox" id="eox">
      <doc xml:lang="en" title="eox"/>
      <resource path="rest" id="rest">
        <doc xml:lang="en" title="rest"/>
        <resource path="{version}" id="{version}">
          <doc xml:lang="en" title="{version}"/>
          <param name="version" default="5" type="xs:int" required="true" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
            <doc xml:lang="en" title="version Parameter">version of this API</doc>
            <option value="4"/>
            <option value="5"/>
          </param>
          <resource path="EOXByDates/{pageIndex}/{startDate}/{endDate}" id="EOXByDates">
            <doc xml:lang="en" title="EOXByDates"/>
            <param name="pageIndex" default="1" type="xs:string" required="true" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="pageIndex Parameter">Index number of the page to return. e.g. 1</doc>
            </param>
            <param name="startDate" default="2012-01-01" type="xs:string" required="true" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="startDate Parameter">Start date of the date range of records to return in the following format: YYYY-MM-DD  e.g. 2010-01-01</doc>
            </param>
            <param name="endDate" default="2012-01-31" type="xs:string" required="true" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="endDate Parameter">End date of the date range of records to return in the following format: YYYY-MM-DD e.g. 2010-01-01</doc>
            </param>
            <param name="eoxAttrib" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="eoxAttrib Parameter">Attribute or attributes of the records to return. Enter multiple values separated by commas. (UPDATED_TIMESTAMP is default)</doc>
              <option value="EO_EXT_ANNOUNCE_DATE"/>
              <option value="EO_SALES_DATE"/>
              <option value="EO_FAIL_ANALYSIS_DATE"/>
              <option value="EO_SW_MAINTENANCE_DATE"/>
              <option value="EO_CONTRACT_RENEW_DATE"/>
              <option value="UPDATED_TIMESTAMP"/>
              <option value=""/>
              <option value="EO_SECURITY_VUL_SUPPORT_DATE"/>
            </param>
            <param name="responseencoding" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="responseencoding Parameter">Either xml or json - to choose output format of response (default is json)</doc>
              <option value="xml"/>
              <option value="json"/>
            </param>
            <method name="GET" id="GET">
              <doc xml:lang="en" title="GET"/>
              <request/>
              <response status="200">
                <representation mediaType="application/json; charset=UTF-8" element="ns:Response" xmlns:ns="https://api.cisco.com/supporttools/eox/rest/4/EOXByDates/1/2012-01-01/2012-01-31"/>
              </response>
            </method>
          </resource>
          <resource path="EOXByProductID/{pageIndex}/{productIDs}" id="EOXByProductIDs">
            <doc xml:lang="en" title="EOXByProductIDs"/>
            <param name="pageIndex" default="1" type="xs:int" required="true" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="pageIndex Parameter">Index number of the page to return. e.g. 1</doc>
            </param>
            <param name="productIDs" default="WIC-1T=" type="xs:string" required="true" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="productIDs Parameter">Product IDs for the products to retrieve from the database. Enter up to 20 PIDs separated by commas. For example: 15216-OADM1-35=,M92S1K9-1.3.3C</doc>
            </param>
            <param name="responseencoding" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="responseencoding Parameter">Either xml or json - to choose output format of response (default is json)</doc>
              <option value="xml"/>
              <option value="json"/>
            </param>
            <method name="GET" id="GET">
              <doc xml:lang="en" title="GET"/>
              <request/>
              <response status="200">
                <representation mediaType="application/json; charset=UTF-8" element="ns:Response" xmlns:ns="https://api.cisco.com/supporttools/eox/rest/4/EOXByProductID/1/1"/>
              </response>
            </method>
          </resource>
          <resource path="EOXBySerialNumber/{pageIndex}/{serialNumbers}" id="EOXBySerialNumber">
            <doc xml:lang="en" title="EOXBySerialNumber"/>
            <param name="pageIndex" default="1" type="xs:int" required="true" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="pageIndex Parameter">Index number of the page to return. e.g. 1</doc>
            </param>
            <param name="serialNumbers" default="FHK0933224R" type="xs:string" required="true" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="serialNumbers Parameter">Serial numbers for the products to retrieve from the database. Enter up to 20 serial numbers separated by commas. e.g. JAE11108ESH,SAD11510738</doc>
            </param>
            <param name="responseencoding" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="responseencoding Parameter">Either xml or json - to choose output format of response (default is json)</doc>
              <option value="xml"/>
              <option value="json"/>
            </param>
            <method name="GET" id="GET">
              <doc xml:lang="en" title="GET"/>
              <request/>
              <response status="200">
                <representation mediaType="application/json; charset=UTF-8" element="fhk:Response" xmlns:fhk="https://api.cisco.com/supporttools/eox/rest/4/EOXBySerialNumber/1/FHK0933224R"/>
              </response>
            </method>
          </resource>
          <resource path="EOXBySWReleaseString/{pageIndex}" id="EOXBySWReleaseString">
            <doc xml:lang="en" title="EOXBySWReleaseString"/>
            <param name="pageIndex" default="1" type="xs:int" required="true" style="template" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="pageIndex Parameter">Index number of the page to return. e.g. 1</doc>
            </param>
            <param name="responseencoding" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="responseencoding Parameter">Either xml or json - to choose output format of response (default is json)</doc>
              <option value="xml"/>
              <option value="json"/>
            </param>
            <param name="input1" default="12.2,IOS" type="xs:string" required="false" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="input1 Parameter">a tuple of SW version and OS-TYPE (comma delmited) only one combination per input (total of 20 inputs allowed per call) see documantion for more info</doc>
            </param>
            <param name="input2" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="input2 Parameter">a tuple of SW version and OS-TYPE (comma delmited) only one combination per input (total of 20 inputs allowed per call) see documantion for more info</doc>
            </param>
            <param name="input3" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="input3 Parameter">a tuple of SW version and OS-TYPE (comma delmited) only one combination per input (total of 20 inputs allowed per call) see documantion for more info</doc>
            </param>
            <param name="input4" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="input4 Parameter">a tuple of SW version and OS-TYPE (comma delmited) only one combination per input (total of 20 inputs allowed per call) see documantion for more info</doc>
            </param>
            <param name="input5" type="xs:string" required="false" default="" style="query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
              <doc xml:lang="en" title="input5 Parameter">a tuple of SW version and OS-TYPE (comma delmited) only one combination per input (total of 20 inputs allowed per call) see documantion for more info</doc>
            </param>
            <method name="GET" id="GET">
              <doc xml:lang="en" title="GET"/>
              <request/>
              <response status="403">
                <representation mediaType="text/xml" element="h1"/>
              </response>
              <response status="200">
                <representation mediaType="application/json; charset=UTF-8" element="ns:Response" xmlns:ns="https://api.cisco.com/supporttools/eox/rest/4/EOXBySWReleaseString/1"/>
              </response>
            </method>
          </resource>
        </resource>
      </resource>
    </resource>
  </resources>
</application>